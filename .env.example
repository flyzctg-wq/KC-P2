# Copy this file to .env and fill in values from your Supabase project
# settings (Project Settings → API). Use the SAME project as
# kunjachaya-supabase/ — that's what makes the database "unified"
# between this web/Android app and any server-side tooling.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — leave blank to skip analytics entirely (nothing loads
# without it, so this is safe either way). Get a GA4 measurement ID
# (looks like "G-XXXXXXX") from Google Analytics if/when you want it.
VITE_GA_MEASUREMENT_ID=
